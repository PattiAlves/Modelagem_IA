import numpy as np
import pandas as pd
from scipy.interpolate import CubicSpline

# 1. Carregar os dados de maré de baixa frequência de um arquivo Excel
# Substitua 'tide_coarse.xlsx' pelo nome do seu arquivo e, se necessário, adicione sheet_name='Nome_da_Planilha'
df_maré = pd.read_excel('Maré_jul10.xlsx', header=None, skiprows=1) # Adicionado skiprows=1 para pular a primeira linha com os rótulos de coluna

# Atribuir nomes corretos às colunas e converter tipos
df_maré.columns = ['datetime', 'nivel']
df_maré['datetime'] = pd.to_datetime(df_maré['datetime'], format='%d/%m/%Y %H:%M')
df_maré['nivel'] = df_maré['nivel'].astype(str).str.replace(',', '.').astype(float)

# Garantir que os dados estejam ordenados cronologicamente
df_maré = df_maré.sort_values('datetime').reset_index(drop=True)

# 2. Converter o índice temporal em segundos (valores numéricos) para a interpolação matemática
tempo_num = df_maré['datetime'].astype(int) / 10**9
niveis = df_maré['nivel'].values

# 3. Criar a função de Interpolação por Spline Cúbica
cs = CubicSpline(tempo_num, niveis, bc_type='not-a-knot')

# 4. Definir a nova grade temporal de alta resolução (a cada 10 minutos)
# Forçando o início exatamente na data solicitada
data_inicio = pd.to_datetime('2010-07-14 17:00:00')
data_fim = df_maré['datetime'].max()  # Vai até a última data disponível na sua planilha

nova_grade = pd.date_range(start=data_inicio, end=data_fim, freq='10min')

# 5. Converter a nova grade para o formato numérico e aplicar a spline
tempo_novo_num = nova_grade.astype(int) / 10**9
niveis_interpolados = cs(tempo_novo_num)

# 6. Montar o DataFrame final com a maré interpolada a cada 10 minutos
df_maré_10min = pd.DataFrame(
    {'datetime': nova_grade, 'nivel_mare_10min': niveis_interpolados}
)

# Visualizar as primeiras linhas do resultado
print(df_maré_10min.head())

# Opcional: Salvar o resultado de volta em um arquivo Excel
df_maré_10min.to_excel('maré_10min.xlsx', index=False)
